<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Documents are read and written through the Storage Access Framework
         (the user picks each file), which grants access without any storage
         permission. INTERNET exists for exactly one thing: the preview
         WebView fetching images a document references by remote URL. The
         app itself makes no network calls and sends nothing anywhere. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Md">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Md">

            <!-- Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open Markdown / plain-text documents handed to us by a file
                 manager, the Files UI, or another app ("Open with md").

                 ACTION_EDIT rides along in every document filter below, never
                 in a filter of its own: a sender that asks for an editor
                 ("Edit with md") and one that asks for a viewer hand over the
                 same document, and what decides whether md may write it back
                 is the grant on the intent, not the action (see
                 DocumentViewModel.openIncoming). Declaring the two actions
                 together is also what keeps the sets in step — they cannot
                 drift apart if there is only one list of `data` elements —
                 and ManifestDocumentTypesTest pins exactly that. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Open Markdown documents by NAME as well. The MIME filter above
                 only fires when the picker types the file, and most type
                 nothing but `.md` / `.markdown` as Markdown: `.mkd`, `.mdown`,
                 `.mdtxt` and the other aliases usually arrive as
                 application/octet-stream, or untyped, and would otherwise never
                 reach md. So every Markdown extension the app claims (the same
                 set as the iOS / macOS / Windows / VS Code siblings — see
                 DocumentTypes.kt, pinned by ManifestDocumentTypesTest) is also
                 matched by `pathSuffix`, `.md` and `.markdown` included so a
                 file manager that mis-types those still opens. Same two-filter
                 shape as PlantUML below, for the same reason.

                 LIMITATION — `pathSuffix` is matched CASE-SENSITIVELY (Android
                 compares the suffix literally), so `NOTES.MD` or `Readme.Md`
                 handed in untyped will not match; typed as text/markdown or
                 text/plain they still open through the MIME filter above. This
                 is left as is on purpose: a pathPattern / pathAdvancedPattern
                 spelling of every case combination is unreadable, and lower-case
                 extensions are what every tool writes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".md" />
                <data android:pathSuffix=".markdown" />
                <data android:pathSuffix=".mdown" />
                <data android:pathSuffix=".markdn" />
                <data android:pathSuffix=".mdtext" />
                <data android:pathSuffix=".mdtxt" />
                <data android:pathSuffix=".mkd" />
                <data android:pathSuffix=".mkdn" />
                <data android:pathSuffix=".mdwn" />
                <data android:pathSuffix=".mkdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".md" />
                <data android:pathSuffix=".markdown" />
                <data android:pathSuffix=".mdown" />
                <data android:pathSuffix=".markdn" />
                <data android:pathSuffix=".mdtext" />
                <data android:pathSuffix=".mdtxt" />
                <data android:pathSuffix=".mkd" />
                <data android:pathSuffix=".mkdn" />
                <data android:pathSuffix=".mdwn" />
                <data android:pathSuffix=".mkdown" />
            </intent-filter>

            <!-- Open PlantUML documents (.puml / .plantuml / .iuml / .pu).
                 PlantUML has no registered MIME type, so match on the filename
                 extension instead — the bytes are UTF-8 text and open in the
                 editor exactly like Markdown. `host="*"` is required for the
                 path to be tested at all. Two filters: one for pickers that tag
                 the intent with a MIME type, one for those that hand us the URI
                 untyped (a filter with a mimeType only matches typed intents,
                 and one without only matches untyped ones). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".puml" />
                <data android:pathSuffix=".plantuml" />
                <data android:pathSuffix=".iuml" />
                <data android:pathSuffix=".pu" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".puml" />
                <data android:pathSuffix=".plantuml" />
                <data android:pathSuffix=".iuml" />
                <data android:pathSuffix=".pu" />
            </intent-filter>

            <!-- Open Graphviz documents (.gv). Same shape as the PlantUML
                 filters above and for the same reasons: DOT has no registered
                 MIME type, so match the extension, and two filters are needed —
                 one for pickers that tag the intent with a MIME type, one for
                 those that hand us the URI untyped. Only `.gv` is claimed:
                 `.dot` is already taken system-wide by Word templates on the
                 Apple siblings, so claiming it there would leave the extension
                 ambiguous; claiming it only on Android would break parity. A
                 `.dot` file just needs renaming — ```dot fenced blocks inside a
                 Markdown document, the common case, are unaffected. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".gv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".gv" />
            </intent-filter>

            <!-- Open TextPack documents (.textpack — a zipped TextBundle). Same
                 extension-matching shape as the PlantUML / Graphviz filters
                 above and for the same reason: a TextPack has no registered MIME
                 type (it is a zip, but tagged application/octet-stream by most
                 pickers), so match the filename, with the usual pair — one for
                 pickers that tag the intent with a MIME type, one for those that
                 hand us the URI untyped. The pack is IMPORTED (its text.md
                 becomes an editable, unsaved buffer — see DocumentViewModel.load
                 / importTextPack), never opened for writing, since it can carry
                 an assets/ folder this text-only document has no place for. A
                 bare .textbundle DIRECTORY is not claimed: a directory package
                 over the Storage Access Framework is a content:// tree, which
                 ACTION_VIEW does not hand out — that gap is reported, not hidden. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".textpack" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".textpack" />
            </intent-filter>

            <!-- Receive shared text — open it as a new untitled document. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Grants the share sheet one-off read access to the PDFs staged
             under cacheDir/exports ("Share Rendered PDF"); nothing else in
             the app's storage is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
